          <title>A. Muscaria</title>
          <pubDate>Fri, 18 May 2018 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/painting/2018/a-muscaria/</link>
