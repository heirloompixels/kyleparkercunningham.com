          <title>transplanter</title>
          <pubDate>Sun, 24 Oct 2021 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/painting/2021/transplanter/</link>
