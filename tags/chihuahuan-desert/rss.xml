&lt;figure class=&quot;art-image&quot;&gt;
  &lt;img
    src=&quot;&#x2F;processed_images&amp;#x2F;IMG_6628.850f250f0ee4b18d.jpg&quot;
    srcset=&quot;&#x2F;processed_images&amp;#x2F;IMG_6628.7e396f619323841d.jpg 480w, &#x2F;processed_images&amp;#x2F;IMG_6628.850f250f0ee4b18d.jpg 960w, &#x2F;processed_images&amp;#x2F;IMG_6628.028d2d311e9588d4.jpg 1600w&quot;
