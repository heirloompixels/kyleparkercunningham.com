      <item>
          <title>Stole the Rainbow</title>
          <pubDate>Sun, 25 Mar 2018 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/printmaking/2018/stole-the-rainbow/</link>
