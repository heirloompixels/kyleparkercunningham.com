      <item>
          <title>Coffee Carafe</title>
          <pubDate>Fri, 05 Dec 2014 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/painting/2014/coffee-carafe/</link>
