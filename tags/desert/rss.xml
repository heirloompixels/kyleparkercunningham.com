    sizes=&quot;(max-width: 640px) 100vw, (max-width: 1200px) 80vw, 900px&quot;
    alt=&quot;Oil painting of a woman in a pink shawl holding a white horse skull up to her face, obscuring half of it, against a muted gray-green background.&quot;
    loading=&quot;lazy&quot;
    decoding=&quot;async&quot;
  &gt;
