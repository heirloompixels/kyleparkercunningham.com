      <item>
          <title>Atmospheric Whales</title>
          <pubDate>Thu, 04 Dec 2014 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/painting/2014/atmospheric-whales/</link>
