      <item>
          <title>Rainfall</title>
          <pubDate>Fri, 03 Apr 2015 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/installation/2015/rainfall/</link>
          <guid>https://kyleparkercunningham.com/oeuvre/installation/2015/rainfall/</guid>
          <description xml:base="https://kyleparkercunningham.com/oeuvre/installation/2015/rainfall/">




&lt;figure class=&quot;art-image&quot;&gt;
  &lt;img
    src=&quot;&#x2F;processed_images&amp;#x2F;IMG_6628.850f250f0ee4b18d.jpg&quot;
