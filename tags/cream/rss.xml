      <item>
          <title>Prickly Pear</title>
          <pubDate>Tue, 24 Apr 2018 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/painting/2018/prickly-pear/</link>
