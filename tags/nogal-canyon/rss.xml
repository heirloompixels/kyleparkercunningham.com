          <title>Nogal Canyon</title>
          <pubDate>Tue, 05 Apr 2022 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/printmaking/2022/nogal-canyon/</link>
