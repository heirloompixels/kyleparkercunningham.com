      <item>
          <title>does math control nature?</title>
          <pubDate>Mon, 29 Jul 2024 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/painting/2024/does-math-control-nature/</link>
