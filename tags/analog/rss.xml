      <item>
          <title>Tubed Pachyderm</title>
          <pubDate>Tue, 07 Feb 2023 00:00:00 +0000</pubDate>
          <author>Unknown</author>
          <link>https://kyleparkercunningham.com/oeuvre/printmaking/2023/tubed-pachydeerm/</link>
